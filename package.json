{
    "name": "discord-logger-bot",
    "version": "1.0.0",
    "type": "module",
    "description": "A Discord bot for logging various events to PostgreSQL.",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "clean": "node -e \"['dist', 'node_modules', 'package-lock.json'].forEach((p) => require('fs').rmSync(p, { recursive: true, force: true }))\" && npm install",
        "dev": "npm run build && NODE_ENV=development node dist/index.js",
        "dev:build:watch": "tsc -w",
        "dev:run:watch": "NODE_ENV=dev node --watch dist/index.js",
        "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
        "type": "tsc --noEmit",
        "lint": "eslint .",
        "lint:strict": "eslint . --max-warnings 0",
        "lint:scripts": "eslint \"scripts/**/*.cjs\"",
        "format": "prettier . --write",
        "lint:log": "npm run lint > eslint.log",
        "lint:count": "npx eslint \"src/**/*.ts\" --format json | jq -r '.[] | select(.errorCount > 0) | \"\\(.errorCount) \\(.filePath)\"' | sort -rn | awk '{print $0; sum += $1} END {print \"----------------------\\nTotal Errors: \" sum}'",
        "verify:renderers": "node scripts/check_renderer_newlines.cjs",
        "verify:release": "npm run lint:strict && npm run lint:scripts && npm run type && npm run build && npm run verify:renderers && npm audit --omit=dev",
        "db:setup": "node scripts/generate_db.cjs",
        "db:migrate": "node scripts/migrate.cjs",
        "db:migrate:storage-path": "node scripts/migrate_attachment_storage_path.cjs",
        "db:prepare:event-id-cutover": "node scripts/prepare_event_id_cutover.cjs",
        "db:cutover:event-logs-swap": "node scripts/cutover_event_logs_swap.cjs"
    },
    "keywords": [
        "discord",
        "bot",
        "logging",
        "typescript",
        "postgresql"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1004.0",
        "@discordjs/rest": "^2.6.0",
        "@marsaud/smb2": "^0.18.0",
        "@sentry/node": "^10.42.0",
        "@sentry/profiling-node": "^10.42.0",
        "axios": "^1.13.6",
        "chalk": "^5.6.2",
        "discord.js": "^14.25.1",
        "dotenv": "^17.3.1",
        "ioredis": "^5.10.0",
        "lodash": "^4.17.23",
        "path-browserify": "^1.0.1",
        "pg": "^8.20.0",
        "webdav": "^5.9.0",
        "xregexp": "^5.1.2"
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@types/node": "^25.3.5",
        "@types/path-browserify": "^1.0.3",
        "@types/pg": "^8.18.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^17.24.0",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-regexp": "^3.0.0",
        "eslint-plugin-security": "^4.0.0",
        "eslint-plugin-unicorn": "^63.0.0",
        "globals": "^17.4.0",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    },
    "overrides": {
        "undici": "^6.24.0",
        "fast-xml-parser": "^5.5.7",
        "minimatch": "^10.2.3",
        "flatted": "^3.4.2"
    }
}
