{
    "name": "discord-logger-bot",
    "version": "1.0.0",
    "type": "module",
    "description": "A Discord bot for logging various events to PostgreSQL.",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "clean": "node -e \"['dist', 'node_modules', 'package-lock.json'].forEach((p) => require('fs').rmSync(p, { recursive: true, force: true }))\" && npm install",
        "dev": "npm run build && NODE_ENV=development node dist/index.js",
        "dev:watch": "NODE_ENV=dev node --watch dist/index.js",
        "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
        "type": "tsc --noEmit",
        "lint": "eslint .",
        "lint:strict": "eslint . --max-warnings 0",
        "lint:scripts": "eslint \"scripts/**/*.cjs\"",
        "format": "prettier . --write",
        "lint:log": "npm run lint > eslint.log",
        "lint:count": "npx eslint \"src/**/*.ts\" --format json | jq -r '.[] | select(.errorCount > 0) | \"\\(.errorCount) \\(.filePath)\"' | sort -rn | awk '{print $0; sum += $1} END {print \"----------------------\\nTotal Errors: \" sum}'"
    },
    "keywords": [
        "discord",
        "bot",
        "logging",
        "typescript",
        "postgresql"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1042.0",
        "@marsaud/smb2": "^0.18.0",
        "@sentry/node": "^10.51.0",
        "@sentry/profiling-node": "^10.51.0",
        "axios": "^1.16.0",
        "chalk": "^5.6.2",
        "discord.js": "^14.26.4",
        "dotenv": "^17.4.2",
        "ioredis": "^5.10.1",
        "pg": "^8.20.0",
        "webdav": "^5.10.0"
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.20.0",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-node": "^0.3.9",
        "eslint-plugin-import-x": "^4.16.2",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-regexp": "^3.1.0",
        "eslint-plugin-security": "^4.0.0",
        "eslint-plugin-unicorn": "^64.0.0",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.2"
    },
    "overrides": {
        "undici": "^6.24.0",
        "fast-xml-parser": "^5.7.3",
        "minimatch": "^10.2.5",
        "flatted": "^3.4.2"
    }
}
