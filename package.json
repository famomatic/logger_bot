{
    "name": "discord-logger-bot",
    "version": "1.0.0",
    "type": "module",
    "description": "A Discord bot for logging various events to PostgreSQL.",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "clean": "rm -rf dist node_modules && npm install",
        "dev": "tsx src/index.ts",
        "build": "tsc",
        "type": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier . --write",
        "lint:log": "npm run lint > eslint.log",
        "lint:count": "npx eslint \"src/**/*.ts\" --format json | jq -r '.[] | select(.errorCount > 0) | \"\\(.errorCount) \\(.filePath)\"' | sort -rn | awk '{print $0; sum += $1} END {print \"----------------------\\nTotal Errors: \" sum}'",
        "db:setup": "node scripts/generate_db.cjs",
        "db:migrate": "node scripts/migrate.cjs",
        "db:migrate:storage-path": "node scripts/migrate_attachment_storage_path.cjs"
    },
    "keywords": [
        "discord",
        "bot",
        "logging",
        "typescript",
        "postgresql"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.988.0",
        "@discordjs/rest": "^2.6.0",
        "@marsaud/smb2": "^0.18.0",
        "@sentry/node": "^10.38.0",
        "@sentry/profiling-node": "^10.38.0",
        "axios": "^1.13.5",
        "chalk": "^5.6.2",
        "discord.js": "^14.25.1",
        "dotenv": "^17.2.4",
        "ioredis": "^5.9.2",
        "lodash": "^4.17.23",
        "node-pty": "^1.1.0",
        "path-browserify": "^1.0.1",
        "pg": "^8.18.0",
        "webdav": "^5.9.0",
        "xregexp": "^5.1.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@types/ioredis": "^5.0.0",
        "@types/node": "^20.12.12",
        "@types/path-browserify": "^1.0.3",
        "@types/pg": "^8.16.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-eslint-comments": "^3.2.0",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.55.0"
    },
    "overrides": {
        "undici": "^6.23.0"
    }
}
