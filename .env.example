# Discord Bot Token  
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# PostgreSQL Bot Database Credentials  
BOT_DB_NAME=
BOT_DB_USER=
BOT_DB_PASSWORD=

# PostgreSQL Connection Details (Optional, defaults are shown)  
PG_HOST=
PG_PORT=
PG_SSL=
PG_SSL_REJECT_UNAUTHORIZED=

# Redis queue (optional, recommended for high event volume)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_QUEUE_NAME=logger:events
LOG_QUEUE_BATCH_SIZE=100
LOG_QUEUE_FLUSH_INTERVAL_MS=1000
LOG_QUEUE_MAX_RETRIES=3

# Startup message recovery (messageCreate backfill after reboot)
MESSAGE_RECOVERY_ENABLED=true
MESSAGE_RECOVERY_MAX_PAGES_PER_CHANNEL=20

# Runtime
NODE_ENV=development

# Storage Provider Selection: local | webdav | s3 | smb
STORAGE_TYPE=local

# Local storage (used when STORAGE_TYPE=local)
LOCAL_STORAGE_PATH=./storage

# WebDAV storage (used when STORAGE_TYPE=webdav)
WEBDAV_HOST=
WEBDAV_PORT=
WEBDAV_HTTPS=true
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_BASE_PATH=/discord_logs

# S3 storage (used when STORAGE_TYPE=s3)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# SMB storage (used when STORAGE_TYPE=smb)
SMB_SHARE_URL=
SMB_DOMAIN=
SMB_USERNAME=
SMB_PASSWORD=

# https://sentry.io
SENTRY_DSN=

# Super administrators (comma separated Discord user IDs)
SUPER_ADMIN_IDS=
