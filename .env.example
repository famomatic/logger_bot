# Discord Bot Token  
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# PostgreSQL Bot Database Credentials  
BOT_DB_NAME=
BOT_DB_USER=
BOT_DB_PASSWORD=

# PostgreSQL Connection Details (Optional, defaults are shown)  
PG_HOST=
PG_PORT=

# Runtime
NODE_ENV=development

# Storage Provider Selection: local | webdav | s3 | smb
STORAGE_TYPE=local

# Local storage (used when STORAGE_TYPE=local)
LOCAL_STORAGE_PATH=./storage

# WebDAV storage (used when STORAGE_TYPE=webdav)
WEBDAV_HOST=
WEBDAV_PORT=
WEBDAV_HTTPS=true
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_BASE_PATH=/discord_logs

# S3 storage (used when STORAGE_TYPE=s3)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# SMB storage (used when STORAGE_TYPE=smb)
SMB_SHARE_URL=
SMB_DOMAIN=
SMB_USERNAME=
SMB_PASSWORD=

# https://sentry.io
SENTRY_DSN=

# Developer Levels (comma separated user IDs)
DEV_LVL1_IDS=
DEV_LVL2_IDS=
DEV_LVL3_IDS=

# Optional command execution settings
SUDO_PASSWORD=
SUDO_PASSWORD_COMMAND=
EXEC_COMMAND_TIMEOUT=
EXEC_COMMAND_TIMEOUT_MS=
